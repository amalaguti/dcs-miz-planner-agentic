{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/lessons-learned.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/readme-on-push.py",
        "matcher": "git\\s+push"
      },
      {
        "command": "python .cursor/hooks/lessons-learned.py",
        "matcher": "git\\s+push"
      },
      {
        "command": "python .cursor/hooks/protect-master.py",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "python .cursor/hooks/protect-master.py",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "failClosed": false
      }
    ]
  }
}
